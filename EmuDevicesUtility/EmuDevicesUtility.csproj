<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>EmuDevicesUtility</RootNamespace>
    <AssemblyName>EmuDevicesUtility</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- M2Mqtt заброшен; переходим на MQTTnet 4.x, уже используемый в DiplomApp.Core -->
    <PackageReference Include="MQTTnet" Version="4.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiplomApp\DiplomApp.Core.csproj" />
  </ItemGroup>

</Project>
